# Real model-provider key: held only by llm-proxy, never passed to the gateway or to sandboxes.
UPSTREAM_API_KEY=
# OpenAI-compatible provider endpoint (default shown). Change together with ALLOWED_MODELS / DEFAULT_MODEL.
# UPSTREAM_BASE_URL=https://openrouter.ai/api/v1
# Shared secret between gateway and llm-proxy (min 16 chars), e.g. `openssl rand -hex 24`.
LLM_ADMIN_SECRET=
# Optional: DEFAULT_MODEL=openrouter/free  ALLOWED_MODELS=<comma list>  DAILY_TOKEN_QUOTA=500000  MONTHLY_TOKEN_QUOTA=5000000 (0 = unlimited)
# Shared secret between gateway and sandbox-runner (min 16 chars), e.g. `openssl rand -hex 24`.
RUNNER_SECRET=
# Optional: OCI runtime for user sandboxes (runsc = gVisor, runc = plain Docker). scripts/restart.sh picks runsc automatically when the
# current Docker daemon has it, so leave this unset unless you want to force one (or use `restart.sh --runtime`). A bare `docker compose up`
# defaults to runc, under which the agent's shell tool does not work.
# SANDBOX_RUNTIME=runsc
# Sign-up needs an invite code (scripts/invite.sh create) unless ALLOW_SIGNUP=true.
# ALLOW_SIGNUP=false
# Outgoing mail (docs/email.md): password reset, emailed invites, a "your workspace finished" notice. Off by default (log sends nothing).
# For Mailgun, set MAIL_PROVIDER=mailgun and the three below, then test with scripts/mail-test.sh you@example.com. Put the key here only
# (this file is not committed) and never in the chat. MAILGUN_REGION is us or eu, whichever your Mailgun domain lives in.
# MAIL_PROVIDER=mailgun
# MAIL_FROM="dsh-cloud <noreply@mg.example.com>"
# MAILGUN_DOMAIN=mg.example.com
# MAILGUN_API_KEY=
# MAILGUN_REGION=us
# MAIL_RESET_MINUTES=60  MAIL_MAX_PER_ADDRESS_HOUR=5  MAIL_MAX_PER_HOUR=100  MAIL_TASK_NOTICES=true  MAIL_TASK_NOTICE_HOURS=6
# Capacity and abuse limits (0 = unlimited). Defaults: 20 running sandboxes, 8 h continuous run time, 2048 MB per user.
# MAX_RUNNING_SANDBOXES=20  MAX_RUN_SECONDS=28800  MAX_DISK_MB=2048  DISK_CHECK_SECONDS=300  EVICT_AFTER_IDLE_SECONDS=300
# When all places are taken and none can be freed, a newcomer waits in line (up to WAIT_QUEUE_SECONDS, default 600; 0 = refuse at once)
# and is started by itself when a place frees. MAX_WAITING (50) bounds the line; WAIT_ABANDON_SECONDS (30) drops someone who left.
# WAIT_QUEUE_SECONDS=600  MAX_WAITING=50
# Tokens for all users together per UTC day; 429 for everyone once used up. Default 5000000.
# GLOBAL_DAILY_TOKEN_BUDGET=5000000
# Audit rows older than this many days are purged (0 = keep forever). Default 90.
# AUDIT_RETENTION_DAYS=90
# An agent that is busy (model calls or CPU use) keeps its sandbox up with the browser closed, up to this many seconds after your
# last activity. 0 = stop idle sandboxes as before. Also BUSY_CPU_PERCENT=5 and BUSY_SIGNAL_SECONDS=300. Default 7200.
# MAX_BUSY_SECONDS=7200
# How the model is named in the picker (default: a friendly name for the free router), and what the workspace is called on screen.
# MODEL_DISPLAY_NAME=Free models (automatic)
# Most one model reply may produce. Too low cuts long file writes off mid-call; the llm-proxy clamps at MAX_OUTPUT_TOKENS (16384).
# MODEL_MAX_OUTPUT_TOKENS=16384
# WORKSPACE_NAME=Workspace

# Web access for sandboxes goes through the egress proxy. By default any public host on ports 80 and 443 is reachable. To restrict it to the
# sites you are working on (plus what git, pip, npm, Go and the vulnerability scanners need), list them; scripts/egress-scope.sh edits this line.
# EGRESS_ALLOW_HOSTS=staging.example.org,*.api.example.org
# Per sandbox and per destination limits (defaults: 100 and 20 new connections a second, 64 and 16 open at once, wait up to 5 s; 0 = off):
# EGRESS_RATE_PER_SOURCE=100  EGRESS_RATE_PER_DESTINATION=20  EGRESS_MAX_CONNECTIONS_PER_SOURCE=64  EGRESS_MAX_CONNECTIONS_PER_DESTINATION=16  EGRESS_LIMIT_WAIT_SECONDS=5
